#!/usr/bin/env bash
# SessionStart hook for agents plugin
# Reads spec-using-agents SKILL.md and injects it as additional context

set -euo pipefail

# Determine plugin root directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Read spec-using-agents content
using_agents_content=$(cat "${PLUGIN_ROOT}/skills/spec-using-agents/SKILL.md" 2>&1 || echo "Error reading spec-using-agents skill")

# Escape string for JSON embedding
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_agents_escaped=$(escape_for_json "$using_agents_content")
session_context="<EXTREMELY_IMPORTANT>\nYou have access to embedded IoT development skills and a persistent knowledge base.\n\n**Below is the full content of your 'spec-using-agents' skill - your guide to using all skills. For other skills, use the 'Skill' tool:**\n\n${using_agents_escaped}\n</EXTREMELY_IMPORTANT>"

# Output context injection as JSON
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context"
fi

# ── TShark2MCP（pcap 分析后端）就绪探测 ──────────────────────────
# 非阻塞：未就绪只向 stderr 打印修复指引，不影响 spec-using-agents 注入。
# 已就绪则静默。
TS_SUBMOD="${PLUGIN_ROOT}/vendor/TShark2MCP"
if [ ! -f "${TS_SUBMOD}/pyproject.toml" ]; then
  echo "[spec-embedded-iot] TShark2MCP 子模块未初始化 —— pcap 分析后端不可用。" >&2
  echo "[spec-embedded-iot]   修复：cd \"${PLUGIN_ROOT}\" && git submodule update --init vendor/TShark2MCP" >&2
elif ! python -c 'import tshark_mcp' >/dev/null 2>&1; then
  echo "[spec-embedded-iot] TShark2MCP 依赖未安装（tshark_mcp 不可 import）—— pcap 分析后端不可用。" >&2
  echo "[spec-embedded-iot]   修复：pip install -r \"${PLUGIN_ROOT}/requirements.txt\"" >&2
fi

exit 0
