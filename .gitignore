# knowledge 是独立 git 仓库（knowledge/.git），不在主仓库追踪
# wiki/ 由 kb.py wiki lint/guide 维护，检索靠 agent 渐进加载（无向量库）
knowledge/

# 仅追踪 spec-* 技能；其它技能（esafenet-file-io、skill-creator、pdf、docs 等）不入库
skills/*
!skills/spec-*/

# 临时/本地文件
/plan.md
**/.archive.lock
# wiki lint 本地检查输出（kb.py wiki lint），不入库
wiki_lint.txt

# 本地工具配置（Claude Code 会话级设置，不入库）
.claude/
.zcode/
